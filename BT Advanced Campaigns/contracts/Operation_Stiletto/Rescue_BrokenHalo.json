			"name": "Dialogue_RecoveringUnitDamaged1",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "We're the [[DM.BaseDescriptionDefs[kosLoreKalskagCoalition],Band of the Damned]]!  We're not the same as those yoohoos at [[DM.Factions[faction_JacobsJuggernauts],Whazername's Paperweights.]]",
