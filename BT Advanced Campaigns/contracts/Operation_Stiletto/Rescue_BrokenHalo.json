					"audioName": "NONE",
					"cameraFocusGuid": "",
					"cameraDistance": "Far",
					"cameraHeight": "Default",
					"revealRadius": -1
				},
				{
					"words": "{MC.If.Company.HasTag.killed_LoT_2ndBatt}Oh right...HQ requesting immediate reinforcements on our location, RHRVx08, over.\n\r\nDamn, wrong channel...",
					"wordsColor": {
