					"audioName": "NONE",
					"cameraFocusGuid": "",
					"cameraDistance": "Far",
					"cameraHeight": "Default",
					"revealRadius": -1
				},
				{
					"words": "{MC.If.Company.HasNoTag.killed_LoT_2ndBatt}Hahaha, so you're the guys who reduced their battalion to a single company.  Let's get 'em boys!",
