						"g": 1,
						"b": 1,
						"a": 1
					},
					"selectedCastDefId": "castDef_TargetTeamLeader",
					"emote": "Default",
					"audioName": "NONE",
					"cameraFocusGuid": "",
					"cameraDistance": "Far",
					"cameraHeight": "Default",
					"revealRadius": -1
				},
				{
					"words": "It's Jacob's Juggernauts!  And we defeated them.",
