	"dialogueList": [
		{
			"dialogue": {
				"EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
			},
			"name": "Dialogue_MissionStart",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "We've marked the location of the downed pilots.",
					"wordsColor": {
						"r": 1,
						"g": 1,
						"b": 1,
						"a": 1
					},
					"selectedCastDefId": "castDef_kos_Anton_Corrigan",
					"emote": "Default",
					"audioName": "NONE",
					"cameraFocusGuid": "",
					"cameraDistance": "Far",
					"cameraHeight": "Default",
					"revealRadius": -1
				},
				{
					"words": "Hostiles are closing on marked area.",
					"wordsColor": {
						"r": 1,
						"g": 1,
						"b": 1,
						"a": 1
					},
					"selectedCastDefId": "castDef_DariusDefault",
					"emote": "Default",
					"audioName": "NONE",
					"cameraFocusGuid": "a85da736-7a2e-4cc6-aff3-feb9d73fc7e1",
					"cameraDistance": "Far",
					"cameraHeight": "Default",
					"revealRadius": -1
				},
				{
					"words": "They must have zero-ed in on the emergency beacon signal.  Get them out, Commander.\n\r\nThose pilots are counting on you.",
					"wordsColor": {
						"r": 1,
						"g": 1,
						"b": 1,
						"a": 1
					},
					"selectedCastDefId": "castDef_kos_Anton_Corrigan",
					"emote": "Default",
					"audioName": "NONE",
					"cameraFocusGuid": "eba2ec63-eab0-4801-b1c5-90964855a7ca",
					"cameraDistance": "Far",
					"cameraHeight": "Default",
					"revealRadius": -1
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
			},
			"name": "Dialogue_MissionSuccess",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "Rescue confirmed.  Pilots secured and will receive medical care.",
					"wordsColor": {
						"r": 1,
						"g": 1,
						"b": 1,
						"a": 1
					},
					"selectedCastDefId": "castDef_DariusDefault",
					"emote": "Default",
					"audioName": "NONE",
					"cameraFocusGuid": "",
					"cameraDistance": "Far",
					"cameraHeight": "Default",
					"revealRadius": -1
				},
				{
					"words": "Great job.  I'll update their squadron of their safe condition.",
					"wordsColor": {
						"r": 1,
						"g": 1,
						"b": 1,
						"a": 1
					},
					"selectedCastDefId": "castDef_kos_Anton_Corrigan",
